# Copy this file to .env and fill in real values before running docker compose.
# .env itself is git-ignored — never commit real credentials.

MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=change-me
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=change-me

# Optional comma-separated CORS allowlist. Leave empty when Nginx serves
# the API under the same origin (/api/).
CORS_ORIGINS=
